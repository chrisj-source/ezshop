NODE_ENV=production
PORT=3000
APP_URL=https://app.yourdomain.com

# MariaDB — the application account (see README step 2)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=es_app
DB_PASSWORD=
MASTER_DB=easyshop_master

# Tenant database credentials resolve by secret_ref.
# company_databases.secret_ref = 'DEFAULT' -> TENANT_SECRET_DEFAULT
# Leave blank to reuse DB_PASSWORD (single-box setup; every tenant DB is owned
# by the same MariaDB account). Set per-ref values when you split them out.
TENANT_SECRET_DEFAULT=

# Per-shop database logins (a0.2.7). With this set, each shop gets its own
# MariaDB login, allowed to read and write only its own database — no CREATE,
# ALTER or DROP. Passwords are COMPUTED from this secret, never stored, so
# there is nothing to add here per shop.
#
#   openssl rand -base64 32
#
# Not an encryption key: nothing is encrypted with it, so losing it costs an
# hour of resetting logins, not any data. Leaking it is worth exactly what the
# shared DB password was worth — keep a copy in a password manager, off the box.
#
# Leave blank and everything behaves as before (one shared login). Existing
# shops move over one at a time with:  npm run tenant-creds
TENANT_MASTER_SECRET=

# openssl rand -hex 32
COOKIE_SECRET=
SESSION_DAYS=14
# Signed out after this many days with no requests, whatever SESSION_DAYS says.
SESSION_IDLE_DAYS=1

# TLS to MariaDB. Off by default (loopback). 1 verifies the server certificate,
# "insecure" skips verification for a self-signed managed database. A tenant
# whose db_host is not loopback gets TLS regardless.
DB_SSL=

# Retention (decided 30 Aug 2026): archival at a year, hard limit at ten.
# Both passes only REPORT until RETENTION_ENABLED=1 — read a retention_runs row
# before switching it on.
RETENTION_ENABLED=
RETENTION_ARCHIVE_MONTHS=12
RETENTION_PURGE_YEARS=10

# openssl rand -hex 32 — salts the EMS agent tokens
EMS_AGENT_TOKEN_SALT=

# Where uploaded documents and EMS files land
STORAGE_DIR=/srv/easyshop-storage

# Redis, for the thumbnail queue. Leave it empty and thumbnails are made during
# the upload instead — slower for whoever is uploading, otherwise the same.
# See INSTALL-MEDIA.md for the tools this needs on the box.
REDIS_URL=redis://127.0.0.1:6379

# Thumbnail jobs at once. Two suits a shop box; raise it if the box is idle.
MEDIA_CONCURRENCY=2

# Rendered PDF pages are dropped this long after anyone last opened them.
PAGE_CACHE_DAYS=30

# Google Calendar (optional, push only). Without these the calendar card on the
# settings screen says the server is not set up. Redirect URI defaults to
# APP_URL + /api/calendar/callback and must match the one in the Google console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
